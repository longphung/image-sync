{
  "expo": {
    "name": "image-sync",
    "slug": "image-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.longphung.imagesync",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "image-sync uses the local network to connect to your Sony camera over Wi-Fi and to find the image-sync desktop app.",
        "NSLocationWhenInUseUsageDescription": "image-sync needs location access to find and join your camera's Wi-Fi network.",
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSBonjourServices": ["_image-sync._tcp"],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050E1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.longphung.imagesync"
    },
    "locales": {
      "vi": "./languages/vi.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      "react-native-wifi-reborn",
      [
        "expo-camera",
        {
          "cameraPermission": "image-sync uses the camera to read your camera's Wi-Fi label and to scan desktop pairing codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "vi"],
            "android": ["en", "vi"]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "image-sync needs access to your photo library to save downloaded camera photos and videos.",
          "savePhotosPermission": "image-sync saves downloaded camera photos and videos to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-video",
      "./plugins/withFfmpegKitMin"
    ],
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
